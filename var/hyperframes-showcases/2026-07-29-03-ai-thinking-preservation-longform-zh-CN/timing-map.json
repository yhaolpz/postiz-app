      "audioDuration": 2.688,
      "audioStart": 140.614,
      "spokenStart": 140.768,
      "spokenEnd": 142.654,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p09-u01",
      "sceneId": "c03-p09",
      "chapterIndex": 2,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "第二，至少比较两种可成立的解释。",
      "gapBefore": 0.16,
      "audioDuration": 2.976,
      "audioStart": 142.65,
      "spokenStart": 142.814,
      "spokenEnd": 144.983,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p10-u01",
      "sceneId": "c03-p10",
      "chapterIndex": 2,
      "paragraphIndex": 9,
      "utteranceIndex": 0,
      "text": "第三，只追问那些会真正改变结论的问题。",
