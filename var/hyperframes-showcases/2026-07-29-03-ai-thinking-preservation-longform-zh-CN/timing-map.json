      "sceneId": "c03-p04",
      "chapterIndex": 2,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "然后要求至少两种替代解释。",
      "gapBefore": 0.16,
      "audioDuration": 2.448,
      "audioStart": 114.287,
      "spokenStart": 114.441,
      "spokenEnd": 116.09,
      "actualGapBefore": 0.16
    },
