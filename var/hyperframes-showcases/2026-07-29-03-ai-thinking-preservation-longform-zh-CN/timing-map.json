      "id": "c04-p03-u02",
      "sceneId": "c04-p03",
      "chapterIndex": 3,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "把原始来源、观察事实和推断分成三栏，能防止流畅语言掩盖证据跳跃。",
      "gapBefore": 0.1,
      "audioDuration": 5.928,
      "audioStart": 159.866,
      "spokenStart": 160.027,
      "spokenEnd": 165.161,
      "actualGapBefore": 0.1
    },
