      "id": "c03-p04-u02",
      "sceneId": "c03-p04",
      "chapterIndex": 2,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "不是为了制造无穷分支，而是防止第一个故事因为表达顺畅就自动胜出。",
      "gapBefore": 0.1,
      "audioDuration": 5.424,
      "audioStart": 116.035,
      "spokenStart": 116.19,
      "spokenEnd": 120.832,
      "actualGapBefore": 0.1
    },
