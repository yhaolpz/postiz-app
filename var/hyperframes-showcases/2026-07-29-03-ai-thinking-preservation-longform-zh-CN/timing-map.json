      "sceneId": "c03-p03",
      "chapterIndex": 2,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "增长和隐私、速度和可维护性、自动化和责任边界，都应该留在同一张桌面上。",
      "gapBefore": 0.1,
      "audioDuration": 6.048,
      "audioStart": 108.886,
      "spokenStart": 109.042,
      "spokenEnd": 114.281,
