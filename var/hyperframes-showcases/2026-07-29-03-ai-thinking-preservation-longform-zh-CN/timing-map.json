      "sceneId": "c03-p02",
      "chapterIndex": 2,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "速度很快，但那些尚未解决的冲突也可能一起被抹平。",
      "gapBefore": 0.1,
      "audioDuration": 4.296,
      "audioStart": 102.418,
      "spokenStart": 102.569,
      "spokenEnd": 106.065,
      "actualGapBefore": 0.1
    },
