      "audioDuration": 2.856,
      "audioStart": 171.579,
      "spokenStart": 171.739,
      "spokenEnd": 173.792,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p05-u02",
      "sceneId": "c04-p05",
      "chapterIndex": 3,
      "paragraphIndex": 4,
      "utteranceIndex": 1,
      "text": "是哪条新证据、哪个定义变化，还是仅仅因为措辞更有说服力。",
      "gapBefore": 0.1,
      "audioDuration": 4.968,
      "audioStart": 173.731,
      "spokenStart": 173.892,
      "spokenEnd": 178.056,
      "actualGapBefore": 0.1
    },
