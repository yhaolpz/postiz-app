      "audioDuration": 3.072,
      "audioStart": 191.008,
      "spokenStart": 191.165,
      "spokenEnd": 193.456,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p09-u01",
      "sceneId": "c04-p09",
      "chapterIndex": 3,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "第二，把事实、来源和推断分开记录。",
      "gapBefore": 0.16,
      "audioDuration": 3.432,
      "audioStart": 193.458,
      "spokenStart": 193.616,
      "spokenEnd": 196.242,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p10-u01",
      "sceneId": "c04-p10",
      "chapterIndex": 3,
      "paragraphIndex": 9,
      "utteranceIndex": 0,
      "text": "第三，用不看答案的复述检查是否真的理解。",
