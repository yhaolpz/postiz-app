      "sceneId": "c04-p04",
      "chapterIndex": 3,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "让 AI 不只写支持项，也写最强反证。",
      "gapBefore": 0.16,
      "audioDuration": 3.504,
      "audioStart": 165.157,
      "spokenStart": 165.321,
      "spokenEnd": 168.013,
      "actualGapBefore": 0.16
    },
