      "id": "c03-p08-u01",
      "sceneId": "c03-p08",
      "chapterIndex": 2,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "本章小节。",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 139.838,
      "spokenStart": 139.992,
      "spokenEnd": 140.668,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p08-u02",
      "sceneId": "c03-p08",
      "chapterIndex": 2,
      "paragraphIndex": 7,
      "utteranceIndex": 1,
      "text": "第一，让冲突目标同时可见。",
