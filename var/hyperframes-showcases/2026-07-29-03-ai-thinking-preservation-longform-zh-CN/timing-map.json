      "sceneId": "c03-p07",
      "chapterIndex": 2,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "重要边界是，这些原型展示了设计方向，不等于已经证明任何场景都能稳定提升判断。",
      "gapBefore": 0.16,
      "audioDuration": 6.528,
      "audioStart": 133.953,
      "spokenStart": 134.116,
      "spokenEnd": 139.832,
      "actualGapBefore": 0.16
    },
