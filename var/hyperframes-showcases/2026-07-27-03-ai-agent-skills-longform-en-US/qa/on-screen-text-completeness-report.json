      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-recap-2",
      "kind": "recap",
      "text": "Expose real decisions",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-recap-3",
      "kind": "recap",
      "text": "Require evidence for risk",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c5-opening",
      "kind": "chapter-opening",
      "text": "A reusable workflow ends with an output another person or Agent can check, edit, and continue.",
