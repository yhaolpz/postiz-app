      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c3-body-2",
      "kind": "body",
      "text": "Keep only decision-changing context",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c3-body-3",
      "kind": "body",
      "text": "Put resources beside the decision",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c3-body-4",
      "kind": "body",
      "text": "Turn caution into observable constraints",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c3-body-5",
      "kind": "body",
      "text": "Memory stores; a skill directs work",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c3-recap-1",
