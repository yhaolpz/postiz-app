      "text": "Attach resources at use time",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-opening",
      "kind": "chapter-opening",
      "text": "The heart of a skill is a small sequence of decisions that a capable teammate could inspect and challenge.",
