      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-body-2",
      "kind": "body",
      "text": "Write decisions, not theater",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-body-3",
      "kind": "body",
      "text": "Every step should change the state",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-body-4",
      "kind": "body",
      "text": "Branch on consequential differences",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-body-5",
      "kind": "body",
      "text": "Confidence is not evidence",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c4-recap-1",
      "kind": "recap",
      "text": "Separate goal and method",
