    },
    {
      "id": "c2-recap-2",
      "kind": "recap",
      "text": "Name the trigger",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c2-recap-3",
      "kind": "recap",
      "text": "Keep discovery flexible",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c3-opening",
      "kind": "chapter-opening",
      "text": "A skill should fetch the context that changes the decision, not every detail from the last project.",
