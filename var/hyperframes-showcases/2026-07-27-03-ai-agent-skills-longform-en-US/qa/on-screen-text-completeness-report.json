      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c1-body-5",
      "kind": "body",
      "text": "Reuse the setup, not your judgment",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c2-opening",
      "kind": "chapter-opening",
      "text": "Start with a task that keeps returning, not with a document you hope people will read.",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c2-body-2",
      "kind": "body",
      "text": "Start from a recognizable trigger",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c2-body-3",
      "kind": "body",
      "text": "Stable intent makes reuse possible",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c2-body-4",
      "kind": "body",
      "text": "Copying is not yet a skill",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c2-body-5",
      "kind": "body",
      "text": "Write when to use it",
      "sourceBinding": "episode.segment",
      "strictNarrationPrefixFragment": false,
      "danglingEnding": false,
      "pass": true
    },
    {
      "id": "c2-recap-1",
      "kind": "recap",
      "text": "Capture a recurring job",
