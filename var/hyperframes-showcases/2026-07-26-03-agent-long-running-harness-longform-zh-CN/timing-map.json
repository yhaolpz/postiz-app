  "segments": [
    {
      "id": "c01-p01-u01",
      "sceneId": "c01-p01",
      "chapterIndex": 0,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "AI Agent 做长期任务时为什么容易跑偏？答案就藏在每次交接里。",
      "gapBefore": 0,
      "audioDuration": 5.328,
      "audioStart": 0,
      "spokenStart": 0.17,
      "spokenEnd": 4.679,
      "actualGapBefore": 0
    },
    {
      "id": "c01-p02-u01",
      "sceneId": "c01-p02",
      "chapterIndex": 0,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "Anthropic 用长周期编程任务研究过这个难题。",
      "gapBefore": 0.16,
      "audioDuration": 3.648,
      "audioStart": 4.672,
      "spokenStart": 4.839,
      "spokenEnd": 7.689,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p02-u02",
      "sceneId": "c01-p02",
      "chapterIndex": 0,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "它给出的实用方向是：别让新会话先猜项目发生过什么。",
      "gapBefore": 0.1,
      "audioDuration": 4.44,
      "audioStart": 7.629,
      "spokenStart": 7.789,
      "spokenEnd": 11.425,
      "actualGapBefore": 0.1
    },
    {
      "id": "c01-p03-u01",
      "sceneId": "c01-p03",
      "chapterIndex": 0,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "没有清晰底座，智能体会重复已完成的工作，或把半成品误认为完成。",
      "gapBefore": 0.16,
      "audioDuration": 5.136,
      "audioStart": 11.425,
      "spokenStart": 11.585,
      "spokenEnd": 15.919,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p03-u02",
      "sceneId": "c01-p03",
      "chapterIndex": 0,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "时间和风险都会被悄悄放大。",
      "gapBefore": 0.1,
      "audioDuration": 2.784,
      "audioStart": 15.86,
      "spokenStart": 16.019,
      "spokenEnd": 18.002,
      "actualGapBefore": 0.1
    },
    {
      "id": "c01-p04-u01",
      "sceneId": "c01-p04",
      "chapterIndex": 0,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "这期的可复用产物是 AI Agent 长期任务进度与交接模板。",
      "gapBefore": 0.16,
      "audioDuration": 4.536,
      "audioStart": 17.994,
      "spokenStart": 18.162,
      "spokenEnd": 21.891,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p04-u02",
      "sceneId": "c01-p04",
      "chapterIndex": 0,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "它把“继续做”变成一个可检查的小步骤。",
      "gapBefore": 0.1,
      "audioDuration": 3.192,
      "audioStart": 21.824,
      "spokenStart": 21.991,
      "spokenEnd": 24.373,
      "actualGapBefore": 0.1
    },
    {
      "id": "c01-p05-u01",
      "sceneId": "c01-p05",
      "chapterIndex": 0,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "我们会依次拆开重启难题、工作底座、下一步粒度、交接内容和验收证据。",
      "gapBefore": 0.16,
      "audioDuration": 5.736,
      "audioStart": 24.369,
      "spokenStart": 24.533,
      "spokenEnd": 29.471,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p05-u02",
      "sceneId": "c01-p05",
      "chapterIndex": 0,
      "paragraphIndex": 4,
      "utteranceIndex": 1,
      "text": "这样每次重启后的进度也能快速复核。",
      "gapBefore": 0.1,
      "audioDuration": 3.384,
      "audioStart": 29.411,
      "spokenStart": 29.571,
      "spokenEnd": 32.154,
      "actualGapBefore": 0.1
    },
    {
      "id": "c01-p06-u01",
      "sceneId": "c01-p06",
      "chapterIndex": 0,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "视频全程干货高价值，让你成为更擅长使用 AI 的人，内容较长，点点关注收藏不迷路。",
      "gapBefore": 0.16,
      "audioDuration": 6.576,
      "audioStart": 32.157,
      "spokenStart": 32.314,
      "spokenEnd": 38.086,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p01-u01",
      "sceneId": "c02-p01",
      "chapterIndex": 1,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "长期任务并不会因为智能体循环运行就天然连续。",
      "gapBefore": 0.18,
      "audioDuration": 4.128,
      "audioStart": 38.108,
      "spokenStart": 38.266,
      "spokenEnd": 41.594,
      "actualGapBefore": 0.18
    },
    {
      "id": "c02-p01-u02",
      "sceneId": "c02-p01",
      "chapterIndex": 1,
      "paragraphIndex": 0,
      "utteranceIndex": 1,
      "text": "每个上下文窗口都可能像一次新的交接班。",
      "gapBefore": 0.1,
      "audioDuration": 3.456,
      "audioStart": 41.531,
      "spokenStart": 41.694,
      "spokenEnd": 44.335,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p01-u03",
      "sceneId": "c02-p01",
      "chapterIndex": 1,
      "paragraphIndex": 0,
      "utteranceIndex": 2,
      "text": "每次重启都要先定位现在的真实状态。",
      "gapBefore": 0.1,
      "audioDuration": 3.312,
      "audioStart": 44.271,
      "spokenStart": 44.435,
      "spokenEnd": 46.943,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p02-u01",
      "sceneId": "c02-p02",
      "chapterIndex": 1,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "这会带来两种常见失败：一次想做太多，或看到部分成果就宣称全任务完成。",
      "gapBefore": 0.16,
      "audioDuration": 6.216,
      "audioStart": 46.944,
      "spokenStart": 47.103,
      "spokenEnd": 52.53,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p02-u02",
      "sceneId": "c02-p02",
      "chapterIndex": 1,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "这两种失败都会让交接成本不断累积。",
      "gapBefore": 0.1,
      "audioDuration": 3.216,
      "audioStart": 52.468,
      "spokenStart": 52.63,
      "spokenEnd": 55.041,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p03-u01",
      "sceneId": "c02-p03",
      "chapterIndex": 1,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "上下文压缩能保留一些信息，但不能替代可查的工作状态。",
      "gapBefore": 0.16,
      "audioDuration": 4.608,
      "audioStart": 55.044,
      "spokenStart": 55.201,
      "spokenEnd": 59.01,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p03-u02",
      "sceneId": "c02-p03",
      "chapterIndex": 1,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "新会话仍要知道现在最重要的是什么。",
      "gapBefore": 0.1,
      "audioDuration": 3.096,
      "audioStart": 58.948,
      "spokenStart": 59.11,
      "spokenEnd": 61.398,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p04-u01",
      "sceneId": "c02-p04",
      "chapterIndex": 1,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "交接不是流水账，而是接口。",
      "gapBefore": 0.16,
      "audioDuration": 2.616,
      "audioStart": 61.41,
      "spokenStart": 61.558,
      "spokenEnd": 63.396,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p04-u02",
      "sceneId": "c02-p04",
      "chapterIndex": 1,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "它要让下一位智能体不用重读全部历史也能选对下一步。",
      "gapBefore": 0.1,
      "audioDuration": 4.344,
      "audioStart": 63.335,
      "spokenStart": 63.496,
      "spokenEnd": 67.027,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p05-u01",
      "sceneId": "c02-p05",
      "chapterIndex": 1,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "真正该问的不是“之前聊了什么”，而是“环境现在有什么证据，还缺什么，下一步做什么”。",
      "gapBefore": 0.16,
      "audioDuration": 6.288,
      "audioStart": 67.02,
      "spokenStart": 67.187,
      "spokenEnd": 72.665,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p06-u01",
      "sceneId": "c02-p06",
      "chapterIndex": 1,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "把小型事实源放在上下文窗口之外，重启才不会靠猜。",
      "gapBefore": 0.16,
      "audioDuration": 4.44,
      "audioStart": 72.663,
      "spokenStart": 72.825,
      "spokenEnd": 76.472,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p07-u01",
      "sceneId": "c02-p07",
      "chapterIndex": 1,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "本章小节。",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 76.478,
      "spokenStart": 76.632,
      "spokenEnd": 77.305,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p07-u02",
      "sceneId": "c02-p07",
      "chapterIndex": 1,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "第一，窗口重启会丢失可用工作状态。",
      "gapBefore": 0.1,
      "audioDuration": 3.216,
      "audioStart": 77.245,
      "spokenStart": 77.405,
      "spokenEnd": 79.833,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p08-u01",
      "sceneId": "c02-p08",
      "chapterIndex": 1,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "第二，半成品容易导致重复劳动或过早宣称完成。",
      "gapBefore": 0.16,
      "audioDuration": 4.152,
      "audioStart": 79.833,
      "spokenStart": 79.993,
      "spokenEnd": 83.342,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p09-u01",
      "sceneId": "c02-p09",
      "chapterIndex": 1,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "第三，下一轮需要行动状态，而不是完整聊天记录。",
      "gapBefore": 0.16,
      "audioDuration": 4.128,
      "audioStart": 83.344,
      "spokenStart": 83.502,
      "spokenEnd": 86.827,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p01-u01",
      "sceneId": "c03-p01",
      "chapterIndex": 2,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "让 AI Agent 开始前，先建立工作底座。",
      "gapBefore": 0.18,
      "audioDuration": 3.408,
      "audioStart": 86.845,
      "spokenStart": 87.007,
      "spokenEnd": 89.609,
      "actualGapBefore": 0.18
    },
    {
      "id": "c03-p01-u02",
      "sceneId": "c03-p01",
      "chapterIndex": 2,
      "paragraphIndex": 0,
      "utteranceIndex": 1,
      "text": "它是新工作可以安全继续的最小已验证状态。",
      "gapBefore": 0.1,
      "audioDuration": 3.624,
      "audioStart": 89.55,
      "spokenStart": 89.709,
      "spokenEnd": 92.547,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p02-u01",
      "sceneId": "c03-p02",
      "chapterIndex": 2,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "在软件任务里，底座通常包括可运行环境、功能清单、进度记录和一次快速端到端检查。",
      "gapBefore": 0.16,
      "audioDuration": 6.744,
      "audioStart": 92.559,
      "spokenStart": 92.707,
      "spokenEnd": 98.681,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p02-u02",
      "sceneId": "c03-p02",
      "chapterIndex": 2,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "别的工作也要有等价锚点，让后续会话不必重复寻找这些信息。",
      "gapBefore": 0.1,
      "audioDuration": 4.824,
      "audioStart": 98.624,
      "spokenStart": 98.781,
      "spokenEnd": 102.813,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p03-u01",
      "sceneId": "c03-p03",
      "chapterIndex": 2,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "初始化智能体的职责不同：它要为后续会话铺路，减少每次都靠推测找方向。",
      "gapBefore": 0.16,
      "audioDuration": 5.928,
      "audioStart": 102.811,
      "spokenStart": 102.973,
      "spokenEnd": 108.09,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p04-u01",
      "sceneId": "c03-p04",
      "chapterIndex": 2,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "需求要放进能看出完成状态的结构里。",
      "gapBefore": 0.16,
      "audioDuration": 3.168,
      "audioStart": 108.095,
      "spokenStart": 108.25,
      "spokenEnd": 110.626,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p04-u02",
      "sceneId": "c03-p04",
      "chapterIndex": 2,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "不是写着“完成”就算完成，而是可观察行为真的通过。",
      "gapBefore": 0.1,
      "audioDuration": 4.104,
      "audioStart": 110.571,
      "spokenStart": 110.726,
      "spokenEnd": 114.036,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p05-u01",
      "sceneId": "c03-p05",
      "chapterIndex": 2,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "同时记录约束：允许的输入、不能碰的边界、已知失败和审阅者需要的证据。",
      "gapBefore": 0.16,
      "audioDuration": 5.808,
      "audioStart": 114.033,
      "spokenStart": 114.196,
      "spokenEnd": 119.207,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p06-u01",
      "sceneId": "c03-p06",
      "chapterIndex": 2,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "稳定底座能减少每一轮重新修地基的冲动，也让下一次检查更快开始。",
      "gapBefore": 0.16,
      "audioDuration": 5.352,
      "audioStart": 119.2,
      "spokenStart": 119.367,
      "spokenEnd": 123.903,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p07-u01",
      "sceneId": "c03-p07",
      "chapterIndex": 2,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "本章小节。",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 123.909,
      "spokenStart": 124.063,
      "spokenEnd": 124.74,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p07-u02",
      "sceneId": "c03-p07",
      "chapterIndex": 2,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "第一，先建立最小可验证的工作底座。",
      "gapBefore": 0.1,
      "audioDuration": 3.144,
      "audioStart": 124.68,
      "spokenStart": 124.84,
      "spokenEnd": 127.182,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p08-u01",
      "sceneId": "c03-p08",
      "chapterIndex": 2,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "第二，让需求与约束可以快速检查。",
      "gapBefore": 0.16,
      "audioDuration": 3.12,
      "audioStart": 127.187,
      "spokenStart": 127.342,
      "spokenEnd": 129.663,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p09-u01",
      "sceneId": "c03-p09",
      "chapterIndex": 2,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "第三，初始化是为后续会话服务，不是一次性交付。",
      "gapBefore": 0.16,
      "audioDuration": 4.176,
      "audioStart": 129.664,
      "spokenStart": 129.823,
      "spokenEnd": 133.196,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p01-u01",
      "sceneId": "c04-p01",
      "chapterIndex": 3,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "有了底座后，把下一步缩小。",
      "gapBefore": 0.18,
      "audioDuration": 2.592,
      "audioStart": 133.218,
      "spokenStart": 133.376,
      "spokenEnd": 135.171,
      "actualGapBefore": 0.18
    },
    {
      "id": "c04-p01-u02",
      "sceneId": "c04-p01",
      "chapterIndex": 3,
      "paragraphIndex": 0,
      "utteranceIndex": 1,
      "text": "AI Agent 做长期任务时，每轮应完成一个有意义的小单元，不要试图一口吞完整项目。",
      "gapBefore": 0.1,
      "audioDuration": 6.168,
      "audioStart": 135.101,
      "spokenStart": 135.271,
      "spokenEnd": 140.618,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p01-u03",
      "sceneId": "c04-p01",
      "chapterIndex": 3,
      "paragraphIndex": 0,
      "utteranceIndex": 2,
      "text": "这样才能在有限窗口里保持判断质量。",
      "gapBefore": 0.1,
      "audioDuration": 3.264,
      "audioStart": 140.558,
      "spokenStart": 140.718,
      "spokenEnd": 143.176,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p02-u01",
      "sceneId": "c04-p02",
      "chapterIndex": 3,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "小单元要边界清楚：一个功能、一条可复现失败、一次数据核对，或一个可审阅决定。",
      "gapBefore": 0.16,
      "audioDuration": 6.456,
      "audioStart": 143.181,
      "spokenStart": 143.336,
      "spokenEnd": 149.005,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p02-u02",
      "sceneId": "c04-p02",
      "chapterIndex": 3,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "它应当装得进本轮上下文。",
      "gapBefore": 0.1,
      "audioDuration": 2.304,
      "audioStart": 148.947,
      "spokenStart": 149.105,
      "spokenEnd": 150.61,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p02-u03",
      "sceneId": "c04-p02",
      "chapterIndex": 3,
      "paragraphIndex": 1,
      "utteranceIndex": 2,
      "text": "边界清楚，验收才不会漂移。",
      "gapBefore": 0.1,
      "audioDuration": 2.712,
      "audioStart": 150.552,
      "spokenStart": 150.71,
      "spokenEnd": 152.63,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p03-u01",
      "sceneId": "c04-p03",
      "chapterIndex": 3,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "小不等于没有结果。",
      "gapBefore": 0.16,
      "audioDuration": 1.872,
      "audioStart": 152.63,
      "spokenStart": 152.79,
      "spokenEnd": 153.856,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p03-u02",
      "sceneId": "c04-p03",
      "chapterIndex": 3,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "智能体要改变真实状态，跑相关检查，并说明检查证明了什么、没有证明什么。",
      "gapBefore": 0.1,
      "audioDuration": 6.192,
      "audioStart": 153.793,
      "spokenStart": 153.956,
      "spokenEnd": 159.363,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p04-u01",
      "sceneId": "c04-p04",
      "chapterIndex": 3,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "这样做不是故意变慢，而是避免半截实现留下昂贵的恢复成本。",
      "gapBefore": 0.16,
      "audioDuration": 4.944,
      "audioStart": 159.362,
      "spokenStart": 159.523,
      "spokenEnd": 163.674,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p05-u01",
      "sceneId": "c04-p05",
      "chapterIndex": 3,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "任务过大时，按用户能观察到的结果拆分，不要只按文件或 token 数量拆。",
      "gapBefore": 0.16,
      "audioDuration": 5.76,
      "audioStart": 163.675,
      "spokenStart": 163.834,
      "spokenEnd": 168.782,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p06-u01",
      "sceneId": "c04-p06",
      "chapterIndex": 3,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "进度模板要写清下一步、成功信号和停止条件。",
      "gapBefore": 0.16,
      "audioDuration": 4.152,
      "audioStart": 168.79,
      "spokenStart": 168.942,
      "spokenEnd": 172.3,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p07-u01",
      "sceneId": "c04-p07",
      "chapterIndex": 3,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "本章小节。",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 172.306,
      "spokenStart": 172.46,
      "spokenEnd": 173.133,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p07-u02",
      "sceneId": "c04-p07",
      "chapterIndex": 3,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "第一，每轮只领取一个有边界的目标。",
      "gapBefore": 0.1,
      "audioDuration": 3,
      "audioStart": 173.077,
      "spokenStart": 173.233,
      "spokenEnd": 175.459,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p08-u01",
      "sceneId": "c04-p08",
      "chapterIndex": 3,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "第二，目标必须绑定真实成功信号。",
      "gapBefore": 0.16,
      "audioDuration": 3.096,
      "audioStart": 175.464,
      "spokenStart": 175.619,
      "spokenEnd": 177.911,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p09-u01",
      "sceneId": "c04-p09",
      "chapterIndex": 3,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "第三，按可观察结果拆分过大的任务。",
      "gapBefore": 0.16,
      "audioDuration": 3.264,
      "audioStart": 177.916,
      "spokenStart": 178.071,
      "spokenEnd": 180.531,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p01-u01",
      "sceneId": "c05-p01",
      "chapterIndex": 4,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "一份可用交接要快速回答四件事：改了什么、验证了什么、哪里未知、下一步最安全的动作是什么。",
      "gapBefore": 0.18,
      "audioDuration": 7.416,
      "audioStart": 180.548,
      "spokenStart": 180.711,
      "spokenEnd": 187.318,
      "actualGapBefore": 0.18
    },
    {
      "id": "c05-p01-u02",
      "sceneId": "c05-p01",
      "chapterIndex": 4,
      "paragraphIndex": 0,
      "utteranceIndex": 1,
      "text": "四项缺一项，下一轮就容易靠猜。",
      "gapBefore": 0.1,
      "audioDuration": 2.928,
      "audioStart": 187.263,
      "spokenStart": 187.418,
      "spokenEnd": 189.562,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p02-u01",
      "sceneId": "c05-p02",
      "chapterIndex": 4,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "把决定和证据写在一起。",
      "gapBefore": 0.16,
      "audioDuration": 2.28,
      "audioStart": 189.559,
      "spokenStart": 189.722,
      "spokenEnd": 191.187,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p02-u02",
      "sceneId": "c05-p02",
      "chapterIndex": 4,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "只写选 B 还不够；要说明 B 通过了这个浏览器检查，而 A 在此处失败，这样才可复用。",
      "gapBefore": 0.1,
      "audioDuration": 6.6,
      "audioStart": 191.114,
      "spokenStart": 191.287,
      "spokenEnd": 197.07,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p02-u03",
      "sceneId": "c05-p02",
      "chapterIndex": 4,
      "paragraphIndex": 1,
      "utteranceIndex": 2,
      "text": "证据越靠近决定，交接越可靠。",
      "gapBefore": 0.1,
      "audioDuration": 2.928,
      "audioStart": 197.004,
      "spokenStart": 197.17,
      "spokenEnd": 199.289,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p03-u01",
      "sceneId": "c05-p03",
      "chapterIndex": 4,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "留下事实源入口，不要复制一整面上下文。",
      "gapBefore": 0.16,
      "audioDuration": 3.504,
      "audioStart": 199.285,
      "spokenStart": 199.449,
      "spokenEnd": 202.136,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p03-u02",
      "sceneId": "c05-p03",
      "chapterIndex": 4,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "下一轮按需打开功能清单、进度记录、测试或产物。",
      "gapBefore": 0.1,
      "audioDuration": 4.392,
      "audioStart": 202.078,
      "spokenStart": 202.236,
      "spokenEnd": 205.823,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p04-u01",
      "sceneId": "c05-p04",
      "chapterIndex": 4,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "环境要干净到另一个人或智能体能马上开始。",
      "gapBefore": 0.16,
      "audioDuration": 3.72,
      "audioStart": 205.802,
      "spokenStart": 205.983,
      "spokenEnd": 208.884,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p04-u02",
      "sceneId": "c05-p04",
      "chapterIndex": 4,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "存在隐藏破损的改动不能算有效进展。",
      "gapBefore": 0.1,
      "audioDuration": 3.216,
      "audioStart": 208.834,
      "spokenStart": 208.984,
      "spokenEnd": 211.399,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p05-u01",
      "sceneId": "c05-p05",
      "chapterIndex": 4,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "交接也要说清边界：不能修改哪个集成、不能宣称哪个指标，或必须等待哪项外部批准。",
      "gapBefore": 0.16,
      "audioDuration": 6.504,
      "audioStart": 211.404,
      "spokenStart": 211.559,
      "spokenEnd": 217.257,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p06-u01",
      "sceneId": "c05-p06",
      "chapterIndex": 4,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "边界让人类仍然掌握关键判断，即使智能体继续执行。",
      "gapBefore": 0.16,
      "audioDuration": 4.536,
      "audioStart": 217.257,
      "spokenStart": 217.417,
      "spokenEnd": 221.154,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p07-u01",
      "sceneId": "c05-p07",
      "chapterIndex": 4,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "本章小节。",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 221.16,
      "spokenStart": 221.314,
      "spokenEnd": 221.987,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p07-u02",
      "sceneId": "c05-p07",
      "chapterIndex": 4,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "第一，交接写清变化、证据、未知和下一步。",
      "gapBefore": 0.1,
      "audioDuration": 4.152,
      "audioStart": 221.933,
      "spokenStart": 222.087,
      "spokenEnd": 225.433,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p08-u01",
      "sceneId": "c05-p08",
      "chapterIndex": 4,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "第二，链接可检查事实源，不复制全部上下文。",
      "gapBefore": 0.16,
      "audioDuration": 4.032,
      "audioStart": 225.439,
      "spokenStart": 225.593,
      "spokenEnd": 228.839,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p09-u01",
      "sceneId": "c05-p09",
      "chapterIndex": 4,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "第三，把不能越过的边界写明白。",
      "gapBefore": 0.16,
      "audioDuration": 2.76,
      "audioStart": 228.841,
      "spokenStart": 228.999,
      "spokenEnd": 230.964,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p01-u01",
      "sceneId": "c06-p01",
      "chapterIndex": 5,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "AI Agent 想把进度标成完成前，要按用户真正感受到的层级验收。",
      "gapBefore": 0.18,
      "audioDuration": 5.112,
      "audioStart": 230.976,
      "spokenStart": 231.144,
      "spokenEnd": 235.448,
      "actualGapBefore": 0.18
    },
    {
      "id": "c06-p01-u02",
      "sceneId": "c06-p01",
      "chapterIndex": 5,
      "paragraphIndex": 0,
      "utteranceIndex": 1,
      "text": "单元测试通过，不代表端到端功能可用。",
      "gapBefore": 0.1,
      "audioDuration": 3.24,
      "audioStart": 235.388,
      "spokenStart": 235.548,
      "spokenEnd": 237.977,
      "actualGapBefore": 0.1
    },
    {
      "id": "c06-p01-u03",
      "sceneId": "c06-p01",
      "chapterIndex": 5,
      "paragraphIndex": 0,
      "utteranceIndex": 2,
      "text": "验收层级越接近用户，错误越早暴露。",
      "gapBefore": 0.1,
      "audioDuration": 3.24,
      "audioStart": 237.914,
      "spokenStart": 238.077,
      "spokenEnd": 240.506,
      "actualGapBefore": 0.1
    },
    {
      "id": "c06-p02-u01",
      "sceneId": "c06-p02",
      "chapterIndex": 5,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "原文在网页应用实验中发现，明确要求智能体使用浏览器自动化做端到端检查后，结果更好。",
      "gapBefore": 0.16,
      "audioDuration": 6.888,
      "audioStart": 240.507,
      "spokenStart": 240.666,
      "spokenEnd": 246.753,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p03-u01",
      "sceneId": "c06-p03",
      "chapterIndex": 5,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "先跑最窄且足够的检查；如果影响界面、集成或交付，再补一条真实工作流检查。",
      "gapBefore": 0.16,
      "audioDuration": 6.312,
      "audioStart": 246.753,
      "spokenStart": 246.913,
      "spokenEnd": 252.437,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p04-u01",
      "sceneId": "c06-p04",
      "chapterIndex": 5,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "有证据后再更新进度卡。",
      "gapBefore": 0.16,
      "audioDuration": 2.376,
      "audioStart": 252.439,
      "spokenStart": 252.597,
      "spokenEnd": 254.182,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p04-u02",
      "sceneId": "c06-p04",
      "chapterIndex": 5,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "通过标记是验收的结果，不能代替验收。",
      "gapBefore": 0.1,
      "audioDuration": 3.264,
      "audioStart": 254.125,
      "spokenStart": 254.282,
      "spokenEnd": 256.756,
      "actualGapBefore": 0.1
    },
    {
      "id": "c06-p05-u01",
      "sceneId": "c06-p05",
      "chapterIndex": 5,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "检查失败时，保留失败现象、复现路径和最小诊断动作。",
      "gapBefore": 0.16,
      "audioDuration": 4.848,
      "audioStart": 256.764,
      "spokenStart": 256.916,
      "spokenEnd": 260.98,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p05-u02",
      "sceneId": "c06-p05",
      "chapterIndex": 5,
      "paragraphIndex": 4,
      "utteranceIndex": 1,
      "text": "这样下一轮才能聚焦继续。",
      "gapBefore": 0.1,
      "audioDuration": 2.28,
      "audioStart": 260.919,
      "spokenStart": 261.08,
      "spokenEnd": 262.562,
      "actualGapBefore": 0.1
    },
    {
      "id": "c06-p05-u03",
      "sceneId": "c06-p05",
      "chapterIndex": 5,
      "paragraphIndex": 4,
      "utteranceIndex": 2,
      "text": "不要把失败藏进一句模糊的待处理。",
      "gapBefore": 0.1,
      "audioDuration": 2.712,
      "audioStart": 262.5,
      "spokenStart": 262.662,
      "spokenEnd": 264.567,
      "actualGapBefore": 0.1
    },
    {
      "id": "c06-p06-u01",
      "sceneId": "c06-p06",
      "chapterIndex": 5,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "这也是人的关口：由人判断当前证据是否匹配这项决定的后果。",
      "gapBefore": 0.16,
      "audioDuration": 4.944,
      "audioStart": 264.566,
      "spokenStart": 264.727,
      "spokenEnd": 268.883,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p07-u01",
      "sceneId": "c06-p07",
      "chapterIndex": 5,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "本章小节。",
      "gapBefore": 0.16,
      "audioDuration": 1.464,
      "audioStart": 268.889,
      "spokenStart": 269.043,
      "spokenEnd": 269.714,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p07-u02",
      "sceneId": "c06-p07",
      "chapterIndex": 5,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "第一，按用户可感知的结果验收。",
      "gapBefore": 0.1,
      "audioDuration": 2.856,
      "audioStart": 269.655,
      "spokenStart": 269.814,
      "spokenEnd": 271.89,
      "actualGapBefore": 0.1
    },
    {
      "id": "c06-p08-u01",
      "sceneId": "c06-p08",
      "chapterIndex": 5,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "第二，有证据后才把任务改为完成。",
      "gapBefore": 0.16,
      "audioDuration": 3.144,
      "audioStart": 271.894,
      "spokenStart": 272.05,
      "spokenEnd": 274.393,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p09-u01",
      "sceneId": "c06-p09",
      "chapterIndex": 5,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "第三，把失败变成明确的下一步诊断。",
      "gapBefore": 0.16,
      "audioDuration": 3.12,
      "audioStart": 274.389,
      "spokenStart": 274.553,
      "spokenEnd": 276.867,
      "actualGapBefore": 0.16
    },
    {
      "id": "c07-p01-u01",
      "sceneId": "c07-p01",
      "chapterIndex": 6,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "长期任务中，AI Agent 的连续性需要被设计出来。",
      "gapBefore": 0.18,
      "audioDuration": 3.864,
      "audioStart": 276.886,
      "spokenStart": 277.047,
      "spokenEnd": 280.11,
      "actualGapBefore": 0.18
    },
    {
      "id": "c07-p02-u01",
      "sceneId": "c07-p02",
      "chapterIndex": 6,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "第一，先建立可运行、需求明确、能快速自检的工作底座。",
      "gapBefore": 0.16,
      "audioDuration": 4.632,
      "audioStart": 280.109,
      "spokenStart": 280.27,
      "spokenEnd": 284.115,
      "actualGapBefore": 0.16
    },
    {
      "id": "c07-p03-u01",
      "sceneId": "c07-p03",
      "chapterIndex": 6,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "第二，每轮完成一个小而可验证的结果。",
      "gapBefore": 0.16,
      "audioDuration": 3.168,
      "audioStart": 284.118,
      "spokenStart": 284.275,
      "spokenEnd": 286.661,
      "actualGapBefore": 0.16
    },
    {
      "id": "c07-p04-u01",
      "sceneId": "c07-p04",
      "chapterIndex": 6,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "第三，交接留下变化、证据、未知、边界和下一步。",
      "gapBefore": 0.16,
      "audioDuration": 4.728,
      "audioStart": 286.661,
      "spokenStart": 286.821,
      "spokenEnd": 290.744,
      "actualGapBefore": 0.16
    },
    {
      "id": "c07-p05-u01",
      "sceneId": "c07-p05",
      "chapterIndex": 6,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "当任务跨会话、跨人或跨上下文窗口时，就使用 AI Agent 长期任务进度与交接模板。",
      "gapBefore": 0.16,
      "audioDuration": 6.624,
      "audioStart": 290.735,
      "spokenStart": 290.904,
      "spokenEnd": 296.707,
      "actualGapBefore": 0.16
    },
    {
      "id": "c07-p05-u02",
      "sceneId": "c07-p05",
      "chapterIndex": 6,
      "paragraphIndex": 4,
      "utteranceIndex": 1,
      "text": "这样复杂工作也能保持可见、可接手。",
      "gapBefore": 0.1,
      "audioDuration": 3.288,
      "audioStart": 296.65,
      "spokenStart": 296.807,
      "spokenEnd": 299.297,
      "actualGapBefore": 0.1
    },
    {
      "id": "c07-p06-u01",
      "sceneId": "c07-p06",
      "chapterIndex": 6,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "最后问自己：一位全新的智能体能不能不用猜，就从这里继续做有价值的工作？",
      "gapBefore": 0.16,
      "audioDuration": 5.856,
      "audioStart": 299.307,
      "spokenStart": 299.457,
      "spokenEnd": 304.552,
      "actualGapBefore": 0.16
    },
    {
      "id": "c07-p07-u01",
      "sceneId": "c07-p07",
      "chapterIndex": 6,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "关注 Tiny Agent，成为更擅长使用 AI 的人！",
      "gapBefore": 0.16,
      "audioDuration": 3.312,
      "audioStart": 304.544,
      "spokenStart": 304.712,
      "spokenEnd": 307.213,
      "actualGapBefore": 0.16
    }
