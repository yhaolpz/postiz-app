  "segments": [
    {
      "id": "c01-p01-u01",
      "sceneId": "c01-p01",
      "chapterIndex": 0,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "How can an AI Agent erode judgment? The risk is outsourced thinking.",
      "gapBefore": 0,
      "audioDuration": 5.136,
      "audioStart": 0,
      "spokenStart": 0.166,
      "spokenEnd": 4.381,
      "actualGapBefore": 0
    },
    {
      "id": "c01-p02-u01",
      "sceneId": "c01-p02",
      "chapterIndex": 0,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "Microsoft Research draws a useful distinction.",
      "gapBefore": 0.16,
      "audioDuration": 3.312,
      "audioStart": 4.379,
      "spokenStart": 4.541,
      "spokenEnd": 6.958,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p02-u02",
      "sceneId": "c01-p02",
      "chapterIndex": 0,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "Assistant mode optimizes completion, while tool-for-thought mode surfaces tension, alternate interpretations, and probing questions.",
      "gapBefore": 0.1,
      "audioDuration": 7.632,
      "audioStart": 6.89,
      "spokenStart": 7.058,
      "spokenEnd": 13.803,
      "actualGapBefore": 0.1
    },
    {
      "id": "c01-p03-u01",
      "sceneId": "c01-p03",
      "chapterIndex": 0,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "The evidence is mixed.",
      "gapBefore": 0.16,
      "audioDuration": 2.064,
      "audioStart": 13.802,
      "spokenStart": 13.963,
      "spokenEnd": 15.134,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p03-u02",
      "sceneId": "c01-p03",
      "chapterIndex": 0,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "AI can improve immediate output, yet some studies find narrower ideas, less critical engagement, or weaker retention.",
      "gapBefore": 0.1,
      "audioDuration": 7.152,
      "audioStart": 15.06,
      "spokenStart": 15.234,
      "spokenEnd": 21.46,
      "actualGapBefore": 0.1
    },
    {
      "id": "c01-p04-u01",
      "sceneId": "c01-p04",
      "chapterIndex": 0,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "This episode is not an argument for avoiding AI.",
      "gapBefore": 0.16,
      "audioDuration": 3.36,
      "audioStart": 21.445,
      "spokenStart": 21.62,
      "spokenEnd": 24.043,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p04-u02",
      "sceneId": "c01-p04",
      "chapterIndex": 0,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "We will build a thought-preservation card that keeps efficiency and judgment together, while separating Microsoft’s prototypes from our synthesis.",
      "gapBefore": 0.1,
      "audioDuration": 7.32,
      "audioStart": 23.978,
      "spokenStart": 24.143,
      "spokenEnd": 30.582,
      "actualGapBefore": 0.1
    },
    {
      "id": "c01-p05-u01",
      "sceneId": "c01-p05",
      "chapterIndex": 0,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "This video is packed with practical, high-value insights to help you get better at using AI.",
      "gapBefore": 0.16,
      "audioDuration": 5.304,
      "audioStart": 30.576,
      "spokenStart": 30.742,
      "spokenEnd": 35.118,
      "actualGapBefore": 0.16
    },
    {
      "id": "c01-p05-u02",
      "sceneId": "c01-p05",
      "chapterIndex": 0,
      "paragraphIndex": 4,
      "utteranceIndex": 1,
      "text": "It's a longer one, so follow Tiny Agent and save it so you don't lose it.",
      "gapBefore": 0.1,
      "audioDuration": 4.488,
      "audioStart": 35.056,
      "spokenStart": 35.218,
      "spokenEnd": 38.822,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p01-u01",
      "sceneId": "c02-p01",
      "chapterIndex": 1,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "The first step is not choosing a model.",
      "gapBefore": 0.18,
      "audioDuration": 2.64,
      "audioStart": 38.813,
      "spokenStart": 39.002,
      "spokenEnd": 40.708,
      "actualGapBefore": 0.18
    },
    {
      "id": "c02-p01-u02",
      "sceneId": "c02-p01",
      "chapterIndex": 1,
      "paragraphIndex": 0,
      "utteranceIndex": 1,
      "text": "It is naming the kind of human thinking this task is supposed to preserve.",
      "gapBefore": 0.1,
      "audioDuration": 4.008,
      "audioStart": 40.628,
      "spokenStart": 40.808,
      "spokenEnd": 43.91,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p02-u01",
      "sceneId": "c02-p02",
      "chapterIndex": 1,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "For formatting, proofreading, or organizing decided fields, reliable completion may be the real goal.",
      "gapBefore": 0.16,
      "audioDuration": 6.408,
      "audioStart": 43.901,
      "spokenStart": 44.07,
      "spokenEnd": 49.544,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p02-u02",
      "sceneId": "c02-p02",
      "chapterIndex": 1,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "Assistant mode often fits.",
      "gapBefore": 0.1,
      "audioDuration": 2.424,
      "audioStart": 49.476,
      "spokenStart": 49.644,
      "spokenEnd": 51.182,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p03-u01",
      "sceneId": "c02-p03",
      "chapterIndex": 1,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "When work requires a view, causal understanding, evidence comparison, or consequences, judgment is part of the deliverable.",
      "gapBefore": 0.16,
      "audioDuration": 7.296,
      "audioStart": 51.176,
      "spokenStart": 51.342,
      "spokenEnd": 57.694,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p04-u01",
      "sceneId": "c02-p04",
      "chapterIndex": 1,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "Write one human learning goal first.",
      "gapBefore": 0.16,
      "audioDuration": 2.736,
      "audioStart": 57.685,
      "spokenStart": 57.854,
      "spokenEnd": 59.706,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p04-u02",
      "sceneId": "c02-p04",
      "chapterIndex": 1,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "For example: I must explain why this option wins, not merely receive a polished recommendation.",
      "gapBefore": 0.1,
      "audioDuration": 5.76,
      "audioStart": 59.634,
      "spokenStart": 59.806,
      "spokenEnd": 64.668,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p05-u01",
      "sceneId": "c02-p05",
      "chapterIndex": 1,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "Mark the dangerous outsourcing points.",
      "gapBefore": 0.16,
      "audioDuration": 2.76,
      "audioStart": 64.674,
      "spokenStart": 64.828,
      "spokenEnd": 66.705,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p05-u02",
      "sceneId": "c02-p05",
      "chapterIndex": 1,
      "paragraphIndex": 4,
      "utteranceIndex": 1,
      "text": "Hypotheses, counterexamples, values, and uncertainty often matter more than polished prose.",
      "gapBefore": 0.1,
      "audioDuration": 6.288,
      "audioStart": 66.636,
      "spokenStart": 66.805,
      "spokenEnd": 72.197,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p06-u01",
      "sceneId": "c02-p06",
      "chapterIndex": 1,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "Microsoft also notes a low-stakes review risk: people may inspect less critically when the system answer looks like a sensible default.",
      "gapBefore": 0.16,
      "audioDuration": 7.128,
      "audioStart": 72.194,
      "spokenStart": 72.357,
      "spokenEnd": 78.589,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p07-u01",
      "sceneId": "c02-p07",
      "chapterIndex": 1,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "Make a minimal independent attempt first.",
      "gapBefore": 0.16,
      "audioDuration": 2.712,
      "audioStart": 78.587,
      "spokenStart": 78.749,
      "spokenEnd": 80.58,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p07-u02",
      "sceneId": "c02-p07",
      "chapterIndex": 1,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "Three rough hypotheses turn the exchange into comparison instead of surrender to the first fluent answer.",
      "gapBefore": 0.1,
      "audioDuration": 5.784,
      "audioStart": 80.513,
      "spokenStart": 80.68,
      "spokenEnd": 85.524,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p08-u01",
      "sceneId": "c02-p08",
      "chapterIndex": 1,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "Chapter recap.",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 85.523,
      "spokenStart": 85.684,
      "spokenEnd": 86.569,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p08-u02",
      "sceneId": "c02-p08",
      "chapterIndex": 1,
      "paragraphIndex": 7,
      "utteranceIndex": 1,
      "text": "First, define the human thinking this task must preserve.",
      "gapBefore": 0.1,
      "audioDuration": 3.816,
      "audioStart": 86.5,
      "spokenStart": 86.669,
      "spokenEnd": 89.579,
      "actualGapBefore": 0.1
    },
    {
      "id": "c02-p09-u01",
      "sceneId": "c02-p09",
      "chapterIndex": 1,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "Second, treat hypotheses, counterexamples, and trade-offs as high-risk outsourcing points.",
      "gapBefore": 0.16,
      "audioDuration": 6.12,
      "audioStart": 89.572,
      "spokenStart": 89.739,
      "spokenEnd": 94.97,
      "actualGapBefore": 0.16
    },
    {
      "id": "c02-p10-u01",
      "sceneId": "c02-p10",
      "chapterIndex": 1,
      "paragraphIndex": 9,
      "utteranceIndex": 0,
      "text": "Third, leave a minimal independent attempt before you read the AI answer.",
      "gapBefore": 0.16,
      "audioDuration": 4.296,
      "audioStart": 94.959,
      "spokenStart": 95.13,
      "spokenEnd": 98.484,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p01-u01",
      "sceneId": "c03-p01",
      "chapterIndex": 2,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "The second step is not asking AI to sound more certain.",
      "gapBefore": 0.18,
      "audioDuration": 3.696,
      "audioStart": 98.474,
      "spokenStart": 98.664,
      "spokenEnd": 101.425,
      "actualGapBefore": 0.18
    },
    {
      "id": "c03-p01-u02",
      "sceneId": "c03-p01",
      "chapterIndex": 2,
      "paragraphIndex": 0,
      "utteranceIndex": 1,
      "text": "Ask it to expose the tensions hiding inside the problem.",
      "gapBefore": 0.1,
      "audioDuration": 3.576,
      "audioStart": 101.354,
      "spokenStart": 101.525,
      "spokenEnd": 104.197,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p02-u01",
      "sceneId": "c03-p02",
      "chapterIndex": 2,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "A conventional assistant quickly compresses ambiguity into a smooth answer.",
      "gapBefore": 0.16,
      "audioDuration": 4.44,
      "audioStart": 104.19,
      "spokenStart": 104.357,
      "spokenEnd": 107.906,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p02-u02",
      "sceneId": "c03-p02",
      "chapterIndex": 2,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "Unresolved conflicts may disappear with the rough edges.",
      "gapBefore": 0.1,
      "audioDuration": 3.576,
      "audioStart": 107.846,
      "spokenStart": 108.006,
      "spokenEnd": 110.694,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p03-u01",
      "sceneId": "c03-p03",
      "chapterIndex": 2,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "A tool for thought keeps competing goals visible: growth and privacy, speed and maintainability, automation and accountability.",
      "gapBefore": 0.16,
      "audioDuration": 7.584,
      "audioStart": 110.687,
      "spokenStart": 110.854,
      "spokenEnd": 117.543,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p04-u01",
      "sceneId": "c03-p04",
      "chapterIndex": 2,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "Request two plausible interpretations.",
      "gapBefore": 0.16,
      "audioDuration": 2.976,
      "audioStart": 117.558,
      "spokenStart": 117.703,
      "spokenEnd": 119.816,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p04-u02",
      "sceneId": "c03-p04",
      "chapterIndex": 2,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "This prevents the first coherent story from winning by presentation alone.",
      "gapBefore": 0.1,
      "audioDuration": 4.224,
      "audioStart": 119.749,
      "spokenStart": 119.916,
      "spokenEnd": 123.24,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p05-u01",
      "sceneId": "c03-p05",
      "chapterIndex": 2,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "Ask what would change the conclusion.",
      "gapBefore": 0.16,
      "audioDuration": 2.472,
      "audioStart": 123.229,
      "spokenStart": 123.4,
      "spokenEnd": 124.984,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p05-u02",
      "sceneId": "c03-p05",
      "chapterIndex": 2,
      "paragraphIndex": 4,
      "utteranceIndex": 1,
      "text": "Which evidence is missing, and which false assumption would collapse the current option?",
      "gapBefore": 0.1,
      "audioDuration": 4.464,
      "audioStart": 124.914,
      "spokenStart": 125.084,
      "spokenEnd": 128.644,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p06-u01",
      "sceneId": "c03-p06",
      "chapterIndex": 2,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "The prototypes Microsoft describes explore these mechanisms by highlighting tensions, offering alternate perspectives, and posing probing questions.",
      "gapBefore": 0.16,
      "audioDuration": 8.16,
      "audioStart": 128.633,
      "spokenStart": 128.804,
      "spokenEnd": 136.06,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p07-u01",
      "sceneId": "c03-p07",
      "chapterIndex": 2,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "Keep the evidence boundary clear.",
      "gapBefore": 0.16,
      "audioDuration": 2.448,
      "audioStart": 136.053,
      "spokenStart": 136.22,
      "spokenEnd": 137.758,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p07-u02",
      "sceneId": "c03-p07",
      "chapterIndex": 2,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "Those prototypes show a design direction;",
      "gapBefore": 0.1,
      "audioDuration": 2.904,
      "audioStart": 137.692,
      "spokenStart": 137.858,
      "spokenEnd": 139.85,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p07-u03",
      "sceneId": "c03-p07",
      "chapterIndex": 2,
      "paragraphIndex": 6,
      "utteranceIndex": 2,
      "text": "they do not prove that every interface or task will reliably improve judgment.",
      "gapBefore": 0.1,
      "audioDuration": 4.536,
      "audioStart": 139.776,
      "spokenStart": 139.95,
      "spokenEnd": 143.583,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p08-u01",
      "sceneId": "c03-p08",
      "chapterIndex": 2,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "Chapter recap.",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 143.582,
      "spokenStart": 143.743,
      "spokenEnd": 144.628,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p08-u02",
      "sceneId": "c03-p08",
      "chapterIndex": 2,
      "paragraphIndex": 7,
      "utteranceIndex": 1,
      "text": "First, keep conflicting goals visible at the same time.",
      "gapBefore": 0.1,
      "audioDuration": 3.744,
      "audioStart": 144.555,
      "spokenStart": 144.728,
      "spokenEnd": 147.572,
      "actualGapBefore": 0.1
    },
    {
      "id": "c03-p09-u01",
      "sceneId": "c03-p09",
      "chapterIndex": 2,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "Second, compare at least two interpretations that could reasonably be true.",
      "gapBefore": 0.16,
      "audioDuration": 4.56,
      "audioStart": 147.565,
      "spokenStart": 147.732,
      "spokenEnd": 151.392,
      "actualGapBefore": 0.16
    },
    {
      "id": "c03-p10-u01",
      "sceneId": "c03-p10",
      "chapterIndex": 2,
      "paragraphIndex": 9,
      "utteranceIndex": 0,
      "text": "Third, pursue only questions that can materially change the decision.",
      "gapBefore": 0.16,
      "audioDuration": 4.248,
      "audioStart": 151.377,
      "spokenStart": 151.552,
      "spokenEnd": 154.865,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p01-u01",
      "sceneId": "c04-p01",
      "chapterIndex": 3,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "The third step is keeping the reasoning trail on the table instead of saving only the final answer.",
      "gapBefore": 0.18,
      "audioDuration": 5.208,
      "audioStart": 154.872,
      "spokenStart": 155.045,
      "spokenEnd": 159.308,
      "actualGapBefore": 0.18
    },
    {
      "id": "c04-p02-u01",
      "sceneId": "c04-p02",
      "chapterIndex": 3,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "Record your initial judgment and confidence.",
      "gapBefore": 0.16,
      "audioDuration": 2.976,
      "audioStart": 159.298,
      "spokenStart": 159.468,
      "spokenEnd": 161.557,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p02-u02",
      "sceneId": "c04-p02",
      "chapterIndex": 3,
      "paragraphIndex": 1,
      "utteranceIndex": 1,
      "text": "When AI responds, append what changed and why instead of overwriting it.",
      "gapBefore": 0.1,
      "audioDuration": 4.608,
      "audioStart": 161.487,
      "spokenStart": 161.657,
      "spokenEnd": 165.369,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p03-u01",
      "sceneId": "c04-p03",
      "chapterIndex": 3,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "Bind important claims to evidence.",
      "gapBefore": 0.16,
      "audioDuration": 2.616,
      "audioStart": 165.356,
      "spokenStart": 165.529,
      "spokenEnd": 167.241,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p03-u02",
      "sceneId": "c04-p03",
      "chapterIndex": 3,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "Separate primary sources, observed facts, and inference so fluent language cannot hide a leap.",
      "gapBefore": 0.1,
      "audioDuration": 5.784,
      "audioStart": 167.174,
      "spokenStart": 167.341,
      "spokenEnd": 172.225,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p04-u01",
      "sceneId": "c04-p04",
      "chapterIndex": 3,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "Ask for the strongest counterevidence, not more supporting points.",
      "gapBefore": 0.16,
      "audioDuration": 4.008,
      "audioStart": 172.203,
      "spokenStart": 172.385,
      "spokenEnd": 175.485,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p04-u02",
      "sceneId": "c04-p04",
      "chapterIndex": 3,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "A judgment that survives challenge is more informative than repeated agreement.",
      "gapBefore": 0.1,
      "audioDuration": 4.2,
      "audioStart": 175.418,
      "spokenStart": 175.585,
      "spokenEnd": 178.889,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p05-u01",
      "sceneId": "c04-p05",
      "chapterIndex": 3,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "When the conclusion changes, preserve why: new evidence, a changed definition, or merely more persuasive language.",
      "gapBefore": 0.16,
      "audioDuration": 7.296,
      "audioStart": 178.881,
      "spokenStart": 179.049,
      "spokenEnd": 185.413,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p06-u01",
      "sceneId": "c04-p06",
      "chapterIndex": 3,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "At the end, close the answer and explain the causal chain in your own words.",
      "gapBefore": 0.16,
      "audioDuration": 4.68,
      "audioStart": 185.411,
      "spokenStart": 185.573,
      "spokenEnd": 189.344,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p06-u02",
      "sceneId": "c04-p06",
      "chapterIndex": 3,
      "paragraphIndex": 5,
      "utteranceIndex": 1,
      "text": "Retrieval without the screen is a simple check on understanding and retention.",
      "gapBefore": 0.1,
      "audioDuration": 4.32,
      "audioStart": 189.296,
      "spokenStart": 189.444,
      "spokenEnd": 192.89,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p07-u01",
      "sceneId": "c04-p07",
      "chapterIndex": 3,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "This process does not remove bias, but it makes the path of influence reviewable and gives a later retrospective something more reliable than memory.",
      "gapBefore": 0.16,
      "audioDuration": 7.632,
      "audioStart": 192.883,
      "spokenStart": 193.05,
      "spokenEnd": 199.781,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p08-u01",
      "sceneId": "c04-p08",
      "chapterIndex": 3,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "Chapter recap.",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 199.78,
      "spokenStart": 199.941,
      "spokenEnd": 200.826,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p08-u02",
      "sceneId": "c04-p08",
      "chapterIndex": 3,
      "paragraphIndex": 7,
      "utteranceIndex": 1,
      "text": "First, preserve the initial judgment and every meaningful revision.",
      "gapBefore": 0.1,
      "audioDuration": 4.08,
      "audioStart": 200.753,
      "spokenStart": 200.926,
      "spokenEnd": 204.075,
      "actualGapBefore": 0.1
    },
    {
      "id": "c04-p09-u01",
      "sceneId": "c04-p09",
      "chapterIndex": 3,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "Second, separate facts, sources, and inference in the record.",
      "gapBefore": 0.16,
      "audioDuration": 4.416,
      "audioStart": 204.053,
      "spokenStart": 204.235,
      "spokenEnd": 207.717,
      "actualGapBefore": 0.16
    },
    {
      "id": "c04-p10-u01",
      "sceneId": "c04-p10",
      "chapterIndex": 3,
      "paragraphIndex": 9,
      "utteranceIndex": 0,
      "text": "Third, test understanding by restating the reasoning without the answer.",
      "gapBefore": 0.16,
      "audioDuration": 4.32,
      "audioStart": 207.706,
      "spokenStart": 207.877,
      "spokenEnd": 211.304,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p01-u01",
      "sceneId": "c05-p01",
      "chapterIndex": 4,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "The fourth step is deciding which gates require a human to make the final judgment.",
      "gapBefore": 0.18,
      "audioDuration": 4.704,
      "audioStart": 211.32,
      "spokenStart": 211.484,
      "spokenEnd": 215.288,
      "actualGapBefore": 0.18
    },
    {
      "id": "c05-p02-u01",
      "sceneId": "c05-p02",
      "chapterIndex": 4,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "Value choices, irreversible effects, rights, or public commitments should not pass automatically because AI reports high confidence.",
      "gapBefore": 0.16,
      "audioDuration": 7.728,
      "audioStart": 215.29,
      "spokenStart": 215.448,
      "spokenEnd": 222.287,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p03-u01",
      "sceneId": "c05-p03",
      "chapterIndex": 4,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "A human gate is more than approval.",
      "gapBefore": 0.16,
      "audioDuration": 2.52,
      "audioStart": 222.284,
      "spokenStart": 222.447,
      "spokenEnd": 224.085,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p03-u02",
      "sceneId": "c05-p03",
      "chapterIndex": 4,
      "paragraphIndex": 2,
      "utteranceIndex": 1,
      "text": "The owner should see alternatives, evidence, uncertainty, and the worst acceptable consequence.",
      "gapBefore": 0.1,
      "audioDuration": 5.856,
      "audioStart": 224.015,
      "spokenStart": 224.185,
      "spokenEnd": 229.14,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p04-u01",
      "sceneId": "c05-p04",
      "chapterIndex": 4,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "An Agent can execute low-risk, reversible steps with a log.",
      "gapBefore": 0.16,
      "audioDuration": 4.104,
      "audioStart": 229.125,
      "spokenStart": 229.3,
      "spokenEnd": 232.523,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p04-u02",
      "sceneId": "c05-p04",
      "chapterIndex": 4,
      "paragraphIndex": 3,
      "utteranceIndex": 1,
      "text": "As risk rises, switch to recommendation.",
      "gapBefore": 0.1,
      "audioDuration": 3.192,
      "audioStart": 232.455,
      "spokenStart": 232.623,
      "spokenEnd": 234.925,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p05-u01",
      "sceneId": "c05-p05",
      "chapterIndex": 4,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "Name who defines success, approves exceptions, and can stop when results deteriorate.",
      "gapBefore": 0.16,
      "audioDuration": 5.616,
      "audioStart": 234.939,
      "spokenStart": 235.085,
      "spokenEnd": 239.82,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p06-u01",
      "sceneId": "c05-p06",
      "chapterIndex": 4,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "Watch for a trap: a reliable-seeming system makes tired reviewers reduce scrutiny exactly when guardrails matter.",
      "gapBefore": 0.16,
      "audioDuration": 6.48,
      "audioStart": 239.81,
      "spokenStart": 239.98,
      "spokenEnd": 245.531,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p07-u01",
      "sceneId": "c05-p07",
      "chapterIndex": 4,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "A good AI workflow does not insert a person everywhere.",
      "gapBefore": 0.16,
      "audioDuration": 3.696,
      "audioStart": 245.519,
      "spokenStart": 245.691,
      "spokenEnd": 248.468,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p07-u02",
      "sceneId": "c05-p07",
      "chapterIndex": 4,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "It reserves scarce human attention for the points that determine direction and consequence.",
      "gapBefore": 0.1,
      "audioDuration": 4.752,
      "audioStart": 248.397,
      "spokenStart": 248.568,
      "spokenEnd": 252.422,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p08-u01",
      "sceneId": "c05-p08",
      "chapterIndex": 4,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "Chapter recap.",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 252.421,
      "spokenStart": 252.582,
      "spokenEnd": 253.467,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p08-u02",
      "sceneId": "c05-p08",
      "chapterIndex": 4,
      "paragraphIndex": 7,
      "utteranceIndex": 1,
      "text": "First, keep value choices and irreversible decisions behind a human gate.",
      "gapBefore": 0.1,
      "audioDuration": 4.68,
      "audioStart": 253.394,
      "spokenStart": 253.567,
      "spokenEnd": 257.347,
      "actualGapBefore": 0.1
    },
    {
      "id": "c05-p09-u01",
      "sceneId": "c05-p09",
      "chapterIndex": 4,
      "paragraphIndex": 8,
      "utteranceIndex": 0,
      "text": "Second, approval must include evidence, uncertainty, and consequences.",
      "gapBefore": 0.16,
      "audioDuration": 5.088,
      "audioStart": 257.336,
      "spokenStart": 257.507,
      "spokenEnd": 261.7,
      "actualGapBefore": 0.16
    },
    {
      "id": "c05-p10-u01",
      "sceneId": "c05-p10",
      "chapterIndex": 4,
      "paragraphIndex": 9,
      "utteranceIndex": 0,
      "text": "Third, concentrate human attention on the moments that change direction.",
      "gapBefore": 0.16,
      "audioDuration": 4.176,
      "audioStart": 261.693,
      "spokenStart": 261.86,
      "spokenEnd": 265.116,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p01-u01",
      "sceneId": "c06-p01",
      "chapterIndex": 5,
      "paragraphIndex": 0,
      "utteranceIndex": 0,
      "text": "Finally, compress the method into a four-field thought-preservation card.",
      "gapBefore": 0.18,
      "audioDuration": 4.344,
      "audioStart": 265.105,
      "spokenStart": 265.296,
      "spokenEnd": 268.691,
      "actualGapBefore": 0.18
    },
    {
      "id": "c06-p02-u01",
      "sceneId": "c06-p02",
      "chapterIndex": 5,
      "paragraphIndex": 1,
      "utteranceIndex": 0,
      "text": "Field one is the human goal: the understanding, judgment, or transferable ability the task must produce.",
      "gapBefore": 0.16,
      "audioDuration": 6.384,
      "audioStart": 268.678,
      "spokenStart": 268.851,
      "spokenEnd": 274.342,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p03-u01",
      "sceneId": "c06-p03",
      "chapterIndex": 5,
      "paragraphIndex": 2,
      "utteranceIndex": 0,
      "text": "Field two is the AI role: organize, challenge, compare, or execute, plus the thinking it must not replace.",
      "gapBefore": 0.16,
      "audioDuration": 7.272,
      "audioStart": 274.325,
      "spokenStart": 274.502,
      "spokenEnd": 280.858,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p04-u01",
      "sceneId": "c06-p04",
      "chapterIndex": 5,
      "paragraphIndex": 3,
      "utteranceIndex": 0,
      "text": "Field three is the evidence action: primary sources, strongest counterevidence, unknowns, and evidence that would change the conclusion.",
      "gapBefore": 0.16,
      "audioDuration": 8.088,
      "audioStart": 280.841,
      "spokenStart": 281.018,
      "spokenEnd": 288.213,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p05-u01",
      "sceneId": "c06-p05",
      "chapterIndex": 5,
      "paragraphIndex": 4,
      "utteranceIndex": 0,
      "text": "Field four is the human gate: who decides to continue, reverse, or publish, with a short reason.",
      "gapBefore": 0.16,
      "audioDuration": 6.264,
      "audioStart": 288.2,
      "spokenStart": 288.373,
      "spokenEnd": 293.724,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p06-u01",
      "sceneId": "c06-p06",
      "chapterIndex": 5,
      "paragraphIndex": 5,
      "utteranceIndex": 0,
      "text": "Use the card in order: make an independent attempt, ask AI to expose tension, compare the evidence, and finish with a reasoned human decision.",
      "gapBefore": 0.16,
      "audioDuration": 8.304,
      "audioStart": 293.717,
      "spokenStart": 293.884,
      "spokenEnd": 301.278,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p07-u01",
      "sceneId": "c06-p07",
      "chapterIndex": 5,
      "paragraphIndex": 6,
      "utteranceIndex": 0,
      "text": "This card is our practical synthesis of the principles in Microsoft’s article, not an official Microsoft template.",
      "gapBefore": 0.16,
      "audioDuration": 6.024,
      "audioStart": 301.271,
      "spokenStart": 301.438,
      "spokenEnd": 306.563,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p07-u02",
      "sceneId": "c06-p07",
      "chapterIndex": 5,
      "paragraphIndex": 6,
      "utteranceIndex": 1,
      "text": "Its purpose is to make preserved thinking visible.",
      "gapBefore": 0.1,
      "audioDuration": 3.048,
      "audioStart": 306.487,
      "spokenStart": 306.663,
      "spokenEnd": 308.751,
      "actualGapBefore": 0.1
    },
    {
      "id": "c06-p08-u01",
      "sceneId": "c06-p08",
      "chapterIndex": 5,
      "paragraphIndex": 7,
      "utteranceIndex": 0,
      "text": "Chapter recap.",
      "gapBefore": 0.16,
      "audioDuration": 1.776,
      "audioStart": 308.75,
      "spokenStart": 308.911,
      "spokenEnd": 309.796,
      "actualGapBefore": 0.16
    },
    {
      "id": "c06-p08-u02",
      "sceneId": "c06-p08",
      "chapterIndex": 5,
      "paragraphIndex": 7,
      "utteranceIndex": 1,
      "text": "First, state the human learning and judgment goal.",
      "gapBefore": 0.1,
      "audioDuration": 3.48,
      "audioStart": 309.719,
